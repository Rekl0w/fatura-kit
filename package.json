{
  "name": "@rekl0w/fatura-kit",
  "version": "0.1.0",
  "description": "GİB e-Arşiv iş akışları için tipli TypeScript istemcisi ve stdio MCP sunucusunu bir arada sunan hibrit npm paketi.",
  "type": "module",
  "license": "MIT",
  "author": "Rekl0w",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rekl0w/fatura-kit.git"
  },
  "homepage": "https://github.com/Rekl0w/fatura-kit#readme",
  "bugs": {
    "url": "https://github.com/Rekl0w/fatura-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gib",
    "fatura",
    "earsiv",
    "efatura",
    "sdk",
    "hybrid",
    "bun",
    "typescript"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0",
    "bun": ">=1.1.0"
  },
  "bin": {
    "fatura-kit": "dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run lint && bun run typecheck && bun run test",
    "prepublishOnly": "bun run build && bun run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
